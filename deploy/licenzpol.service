[Unit]
Description=LicenzPol FastAPI + React production service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hermesguest
Group=hermesguest
WorkingDirectory=/home/hermesguest/workspace/Licenzpol-definitivamente/backend
EnvironmentFile=/home/hermesguest/workspace/Licenzpol-definitivamente/backend/.env
ExecStart=/home/hermesguest/workspace/Licenzpol-definitivamente/backend/.venv/bin/uvicorn deploy_app:app --host 127.0.0.1 --port 8002 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/home/hermesguest/workspace/Licenzpol-definitivamente/.runtime
UMask=0077

[Install]
WantedBy=multi-user.target

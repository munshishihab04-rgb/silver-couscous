# Production template — copy outside Git and replace every placeholder.
APP_ENV=production
COMMERCE_ENABLED=false
SEARCH_INDEXING_ENABLED=false
CATALOG_PREVIEW_SCOPE=market
EMAIL_DELIVERY_MODE=dry-run
PUBLIC_SITE_URL=https://licenzpol.it
CORS_ORIGINS=https://licenzpol.it,https://www.licenzpol.it
ALLOWED_HOSTS=licenzpol.it,www.licenzpol.it,127.0.0.1,localhost
MONGO_URL=mongodb://127.0.0.1:27018
DB_NAME=licenzpol_production
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_MINUTES=240
LICENSE_KEY_ENCRYPTION_KEY=replace-with-a-dedicated-fernet-key
BACKUP_ENCRYPTION_KEY=replace-with-a-separate-fernet-key
ADMIN_EMAIL=admin@licenzpol.it
ADMIN_PASSWORD=replace-with-a-unique-bootstrap-password
BREVO_API_KEY=
BREVO_SENDER_EMAIL=supporto@licenzpol.it
BREVO_SENDER_NAME=LicenzPol
BREVO_WEBHOOK_SECRET=
NEXI_ENV=sandbox
NEXI_API_KEY=
NEXI_TENANT_ID=
NEXI_MERCHANT_ID=
NEXI_TERMINAL_ID=
NEXI_PUBLIC_API_URL=https://licenzpol.it
